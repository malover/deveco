#!/usr/bin/env bash
set -euo pipefail
APP=deveco

MUTED='\033[0;2m'
GREEN='\033[0;32m'
RED='\033[0;31m'
ORANGE='\033[38;5;214m'
NC='\033[0m' # No Color

# GitCode repository (override via env for testing)
GITCODE_OWNER=${GITCODE_OWNER:-openharmony-sig}
GITCODE_REPO=${GITCODE_REPO:-deveco-code}
GITCODE_API="https://gitcode.com/api/v5/repos/${GITCODE_OWNER}/${GITCODE_REPO}"

# ─── Friendly error helpers ──────────────────────────────────────────────────
die() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
    [ -n "${2:-}" ] && echo -e "${MUTED}  -> $2${NC}" >&2
    exit 1
}

warn() {
    echo -e "${ORANGE}[WARN]${NC} $1" >&2
    [ -n "${2:-}" ] && echo -e "${MUTED}  -> $2${NC}" >&2
}

# ─── Dependency checks ───────────────────────────────────────────────────────
if ! command -v curl >/dev/null 2>&1; then
    die "'curl' is required but not installed"
fi
if ! command -v jq >/dev/null 2>&1; then
    die "'jq' is required but not installed" "macOS: brew install jq  |  Ubuntu: sudo apt install jq"
fi

# ─── Global cleanup trap ────────────────────────────────────────────────────
cleanup() {
    rm -rf "${TMPDIR:-/tmp}/deveco_install_$$"
    printf '\033[?25h' 2>/dev/null
}
trap cleanup EXIT

usage() {
    cat <<EOF
DevEco Code Installer

Usage: install [options]

Options:
    -h, --help              Display this help message
    -v, --version <version> Install a specific version (e.g., 0.1.4)
    -b, --binary <path>     Install from a local binary instead of downloading
        --no-modify-path    Don't modify shell config files (.zshrc, .bashrc, etc.)

Environment:
    GITCODE_OWNER           GitCode repo owner (default: openharmony-sig)
    GITCODE_REPO            GitCode repo name (default: deveco-code)
    VERSION                 Version to install (overridden by --version)

Examples:
    curl -fsSL https://raw.gitcode.com/openharmony-sig/deveco-code/raw/develop/install | bash
    curl -fsSL https://raw.gitcode.com/openharmony-sig/deveco-code/raw/develop/install | bash -s -- --version 0.1.4
    ./install --binary /path/to/deveco
EOF
}

requested_version=${VERSION:-}
no_modify_path=false
binary_path=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -v|--version)
            if [[ -n "${2:-}" ]]; then
                requested_version="$2"
                shift 2
            else
                die "--version requires a version argument" "Usage: install --version 0.1.4"
            fi
            ;;
        -b|--binary)
            if [[ -n "${2:-}" ]]; then
                binary_path="$2"
                shift 2
            else
                die "--binary requires a file path" "Usage: install --binary /path/to/deveco"
            fi
            ;;
        --no-modify-path)
            no_modify_path=true
            shift
            ;;
        *)
            warn "Unknown option '$1', ignoring" "Run install --help to see available options"
            shift
            ;;
    esac
done

INSTALL_DIR=$HOME/.deveco/bin
mkdir -p "$INSTALL_DIR"

# If --binary is provided, skip all download/detection logic
if [ -n "$binary_path" ]; then
    if [ ! -f "$binary_path" ]; then
        die "Binary not found: ${binary_path}" "Please check the path and try again"
    fi
    specific_version="local"
else
    raw_os=$(uname -s)
    case "$raw_os" in
      Darwin*) os="darwin" ;;
      MINGW*|MSYS*|CYGWIN*) os="windows" ;;
      *)
        die "Unsupported OS: $raw_os" "DevEco Code currently supports macOS and Windows (via Git Bash)"
        ;;
    esac

    arch=$(uname -m)
    if [[ "$arch" == "aarch64" ]]; then
      arch="arm64"
    fi
    if [[ "$arch" == "x86_64" ]]; then
      arch="x64"
    fi

    # macOS: detect Rosetta and use arm64 native binary
    if [ "$os" = "darwin" ] && [ "$arch" = "x64" ]; then
      rosetta_flag=$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)
      if [ "$rosetta_flag" = "1" ]; then
        arch="arm64"
      fi
    fi

    combo="$os-$arch"
    case "$combo" in
      darwin-x64|darwin-arm64|windows-x64)
        ;;
      *)
        die "Unsupported platform: $os/$arch" "Supported: macOS (Apple Silicon / Intel), Windows x64"
        ;;
    esac

    # Windows: detect AVX2 support for baseline fallback
    needs_baseline=false
    if [ "$os" = "windows" ] && [ "$arch" = "x64" ]; then
      ps="(Add-Type -MemberDefinition \"[DllImport(\"\"kernel32.dll\"\")] public static extern bool IsProcessorFeaturePresent(int ProcessorFeature);\" -Name Kernel32 -Namespace Win32 -PassThru)::IsProcessorFeaturePresent(40)"
      out=""
      if command -v powershell.exe >/dev/null 2>&1; then
        out=$(powershell.exe -NoProfile -NonInteractive -Command "$ps" 2>/dev/null || true)
      elif command -v pwsh >/dev/null 2>&1; then
        out=$(pwsh -NoProfile -NonInteractive -Command "$ps" 2>/dev/null || true)
      fi
      out=$(echo "$out" | tr -d '\r' | tr '[:upper:]' '[:lower:]' | tr '[:space:]')
      if [ "$out" != "true" ] && [ "$out" != "1" ]; then
        needs_baseline=true
      fi
    fi

    target="$os-$arch"
    if [ "$needs_baseline" = "true" ]; then
      target="$target-baseline"
    fi

    filename="$APP-$target.zip"

    if ! command -v unzip >/dev/null 2>&1; then
        die "'unzip' is required but not installed" "macOS: brew install unzip  |  Ubuntu: sudo apt install unzip"
    fi

    if [ -z "$requested_version" ]; then
        # Fetch latest version from GitCode tags API
        tags_json=$(curl -sS "${GITCODE_API}/tags?per_page=100" 2>/dev/null) || {
            die "Failed to fetch version info from GitCode" "Check your network, or visit https://gitcode.com/${GITCODE_OWNER}/${GITCODE_REPO}/releases"
        }
        specific_version=$(echo "$tags_json" | jq -r '.[].name' 2>/dev/null \
            | grep -E '^v?[0-9]+\.[0-9]+\.[0-9]+$' \
            | sed 's/^v//' \
            | sort -t. -k1,1nr -k2,2nr -k3,3nr \
            | head -1 || true)

        if [[ -z "$specific_version" ]]; then
            die "No valid version tags found on GitCode" "Visit https://gitcode.com/${GITCODE_OWNER}/${GITCODE_REPO}/releases to check available versions"
        fi
    else
        # Strip leading 'v' if present
        requested_version="${requested_version#v}"
        specific_version=$requested_version

        # Verify the release exists
        http_status=$(curl -sS -o /dev/null -w "%{http_code}" "${GITCODE_API}/releases/v${requested_version}" 2>/dev/null || echo "000")
        if [ "$http_status" != "200" ]; then
            die "Release v${requested_version} not found or unavailable (HTTP ${http_status})" "Available releases: https://gitcode.com/${GITCODE_OWNER}/${GITCODE_REPO}/releases"
        fi
    fi
    url="${GITCODE_API}/releases/v${specific_version}/attach_files/${filename}/download"
fi

print_message() {
    local level=$1
    local message=$2
    local color=""

    case $level in
        info) color="${NC}" ;;
        warning) color="${NC}" ;;
        error) color="${RED}" ;;
    esac

    echo -e "${color}${message}${NC}"
}

check_version() {
    if command -v deveco >/dev/null 2>&1; then
        ## Check the installed version
        installed_version=$(deveco --version 2>/dev/null || echo "")

        if [[ "$installed_version" != "$specific_version" ]]; then
            print_message info "${MUTED}Installed version: ${NC}$installed_version."
        else
            print_message info "${MUTED}Version ${NC}$specific_version${MUTED} already installed, skipping"
            exit 0
        fi
    fi
}

unbuffered_sed() {
    if echo | sed -u -e "" >/dev/null 2>&1; then
        sed -nu "$@"
    elif echo | sed -l -e "" >/dev/null 2>&1; then
        sed -nl "$@"
    else
        local pad="$(printf "\n%512s" "")"
        sed -ne "s/$/\\${pad}/" "$@"
    fi
}

print_progress() {
    local bytes="$1"
    local length="$2"
    [ "$length" -gt 0 ] || return 0

    local width=50
    local percent=$(( bytes * 100 / length ))
    [ "$percent" -gt 100 ] && percent=100
    local on=$(( percent * width / 100 ))
    local off=$(( width - on ))

    local filled=$(printf "%*s" "$on" "")
    filled=${filled// /■}
    local empty=$(printf "%*s" "$off" "")
    empty=${empty// /･}

    printf "\r${ORANGE}%s%s %3d%%${NC}" "$filled" "$empty" "$percent" >&4
}

download_with_progress() {
    local url="$1"
    local output="$2"

    if [ -t 2 ]; then
        exec 4>&2
    else
        exec 4>/dev/null
    fi

    local tmp_dir=${TMPDIR:-/tmp}
    local basename="${tmp_dir}/deveco_install_$$_fifo"
    local tracefile="${basename}.trace"

    rm -f "$tracefile"
    mkfifo "$tracefile"

    # Hide cursor
    printf "\033[?25l" >&4

    trap "trap - RETURN; rm -f \"$tracefile\"; printf '\033[?25h' >&4; exec 4>&-" RETURN

    (
        curl -f --trace-ascii "$tracefile" -s -L -o "$output" "$url"
    ) &
    local curl_pid=$!

    unbuffered_sed \
        -e 'y/ACDEGHLNORTV/acdeghlnortv/' \
        -e '/^0000: content-length:/p' \
        -e '/^<= recv data/p' \
        "$tracefile" | \
    {
        local length=0
        local bytes=0

        while IFS=" " read -r -a line; do
            [ "${#line[@]}" -lt 2 ] && continue
            local tag="${line[0]} ${line[1]}"

            if [ "$tag" = "0000: content-length:" ]; then
                length="${line[2]}"
                length=$(echo "$length" | tr -d '\r')
                bytes=0
            elif [ "$tag" = "<= recv" ]; then
                local size="${line[3]}"
                bytes=$(( bytes + size ))
                if [ "$length" -gt 0 ]; then
                    print_progress "$bytes" "$length"
                fi
            fi
        done
    }

    wait $curl_pid
    local ret=$?
    echo "" >&4
    return $ret
}

download_and_install() {
    print_message info "\n${MUTED}Installing ${NC}deveco ${MUTED}version: ${NC}$specific_version"
    local tmp_dir="${TMPDIR:-/tmp}/deveco_install_$$"
    mkdir -p "$tmp_dir"

    if [[ "$os" == "windows" ]] || ! [ -t 2 ] || ! download_with_progress "$url" "$tmp_dir/$filename"; then
        curl -f -# -L -o "$tmp_dir/$filename" "$url"
    fi

    if [ ! -f "$tmp_dir/$filename" ] || [ ! -s "$tmp_dir/$filename" ]; then
        rm -rf "$tmp_dir"
        die "Download failed — file is empty or missing" "Check your network, or download manually from https://gitcode.com/${GITCODE_OWNER}/${GITCODE_REPO}/releases"
    fi

    if ! unzip -q "$tmp_dir/$filename" -d "$tmp_dir" 2>/dev/null; then
        rm -rf "$tmp_dir"
        die "Failed to extract archive — file may be corrupted" "Try running the install command again, or download the zip manually"
    fi

    # Find the binary - it may be at root or in bin/ subdirectory
    local binary_src="$tmp_dir/$APP"
    if [ ! -f "$binary_src" ]; then
        binary_src=$(find "$tmp_dir" -name "$APP" -type f -print -quit)
    fi
    if [ -z "$binary_src" ] || [ ! -f "$binary_src" ]; then
        rm -rf "$tmp_dir"
        die "Binary '$APP' not found in the archive" "The package may be corrupted — try downloading again"
    fi

    mv "$binary_src" "$INSTALL_DIR"
    chmod 755 "${INSTALL_DIR}/$APP"

    # Copy vendor directory if present (ripgrep, mcp-bridge, etc.)
    local vendor_src
    vendor_src=$(find "$tmp_dir" -type d -name vendor -print -quit)
    if [ -n "$vendor_src" ]; then
        mkdir -p "${INSTALL_DIR}/../vendor"
        cp -r "$vendor_src"/* "${INSTALL_DIR}/../vendor/" 2>/dev/null || true
    fi

    # Copy CHANGELOG.md to install root (needed by /release-notes)
    local changelog_src
    changelog_src=$(find "$tmp_dir" -maxdepth 2 -name "CHANGELOG.md" -not -path "*/bin/*" -not -path "*/vendor/*" -print -quit)
    if [ -n "$changelog_src" ]; then
        cp "$changelog_src" "${INSTALL_DIR}/../CHANGELOG.md"
    fi

    # Post-install smoke test
    if ! "${INSTALL_DIR}/${APP}" --version >/dev/null 2>&1; then
        rm -f "${INSTALL_DIR}/${APP}"
        rm -rf "$tmp_dir"
        die "Installation verification failed" "${INSTALL_DIR}/${APP} could not run — platform may be incompatible"
    fi

    rm -rf "$tmp_dir"
}

install_from_binary() {
    print_message info "\n${MUTED}Installing ${NC}deveco ${MUTED}from: ${NC}$binary_path"
    cp "$binary_path" "${INSTALL_DIR}/$APP"
    chmod 755 "${INSTALL_DIR}/$APP"
}

if [ -n "$binary_path" ]; then
    install_from_binary
else
    check_version
    download_and_install
fi


add_to_path() {
    local config_file=$1
    local command=$2

    if grep -Fxq "$command" "$config_file"; then
        print_message info "${MUTED}PATH already configured in ${NC}$config_file${MUTED}, skipping${NC}"
    elif [[ -w $config_file ]]; then
        echo -e "\n# deveco" >> "$config_file"
        echo "$command" >> "$config_file"
        print_message info "${GREEN}[OK]${NC} Added deveco to \$PATH ($config_file)"
        _path_modified=true
    else
        warn "Cannot write to $config_file — please add PATH manually"
        print_message info "  $command"
    fi
}

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}

current_shell=$(basename "$SHELL")
case $current_shell in
    fish)
        config_files="$HOME/.config/fish/config.fish"
    ;;
    zsh)
        config_files="${ZDOTDIR:-$HOME}/.zshrc ${ZDOTDIR:-$HOME}/.zshenv $XDG_CONFIG_HOME/zsh/.zshrc $XDG_CONFIG_HOME/zsh/.zshenv"
    ;;
    bash)
        config_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
    ash)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    sh)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    *)
        # Default case if none of the above matches
        config_files="$HOME/.bashrc $HOME/.bash_profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
esac

_path_modified=false

if [[ "$no_modify_path" != "true" ]]; then
    config_file=""
    for file in $config_files; do
        if [[ -f $file ]]; then
            config_file=$file
            break
        fi
    done

    if [[ -z $config_file ]]; then
        warn "No shell config file found for $current_shell" "Please add the following to your shell config manually:"
        print_message info "  export PATH=$INSTALL_DIR:\$PATH"
    elif [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
        case $current_shell in
            fish)
                add_to_path "$config_file" "fish_add_path $INSTALL_DIR"
            ;;
            zsh)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            bash)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            ash)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            sh)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            *)
                export PATH=$INSTALL_DIR:$PATH
                warn "Unrecognized shell — please add PATH manually"
                print_message info "  export PATH=$INSTALL_DIR:\$PATH"
            ;;
        esac
    fi
fi

if [ -n "${GITHUB_ACTIONS-}" ] && [ "${GITHUB_ACTIONS}" == "true" ]; then
    echo "$INSTALL_DIR" >> $GITHUB_PATH
    print_message info "Added $INSTALL_DIR to \$GITHUB_PATH"
fi

echo -e ""
echo -e "${NC}▃▃▃▃  ▃▃▃▃ ▃   ▃ ▃▃▃▃  ▃▃▃   ▃▃▃     ▃▃▃   ▃▃▃  ▃▃▃▃  ▃▃▃▃${NC}"
echo -e "${NC}▃   ▃ ▃    ▃   ▃ ▃    ▃   ▃ ▃   ▃   ▃   ▃ ▃   ▃ ▃   ▃ ▃   ${NC}"
echo -e "${NC}▄   ▄ ▄▄▄▄ ▄   ▄ ▄▄▄▄ ▄     ▄   ▄   ▄     ▄   ▄ ▄   ▄ ▄▄▄▄${NC}"
echo -e "${NC}▅   ▅ ▅    ▅   ▅ ▅    ▅   ▅ ▅   ▅   ▅   ▅ ▅   ▅ ▅   ▅ ▅   ${NC}"
echo -e "${NC}▆▆▆▆  ▆▆▆▆  ▆▆▆  ▆▆▆▆  ▆▆▆   ▆▆▆     ▆▆▆   ▆▆▆  ▆▆▆▆  ▆▆▆▆${NC}"
echo -e ""
if [ "$specific_version" = "local" ]; then
    echo -e "${MUTED}Local binary installed.${NC}"
else
    echo -e "${MUTED}v$specific_version installed.${NC}"
fi
echo -e ""

# Source hint if PATH was just modified
if [ "$_path_modified" = true ]; then
    echo -e "${MUTED}To activate PATH, run:${NC}"
    echo -e ""
    echo -e "  ${GREEN}source $config_file${NC}"
    echo -e ""
    echo -e "${MUTED}(or open a new terminal)${NC}"
    echo -e ""
fi

echo -e "${MUTED}Get started:${NC}"
echo -e ""
echo -e "cd <project>  ${MUTED}# Open your project directory${NC}"
echo -e "deveco        ${MUTED}# Launch DevEco Code${NC}"
echo -e ""
